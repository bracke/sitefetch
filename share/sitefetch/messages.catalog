si.usage.line1 = "භාවිතය: sitefetch [--help] [--version]"
si.usage.line2 = "       sitefetch [--quiet|-q] [--verbose|-v] [--locale LOCALE] [--jsonl] [--json-summary] [--max-pages N] [--max-depth N] [--max-bytes N] [--max-failures N] [--retries N] [--retry-delay-ms N] [--retry-jitter-ms N] [--request-delay-ms N] [--workers N] [--skip-dangerous] [--safe] [--head MODE] [--robots] [--cache MODE] [--incremental] [--refresh-cache] [--offline-cache] [--cache-max-stale-ms N] [--cache-hash MODE] [--cache-documents-only|--cache-downloads-only] [--cache-require-version] [--cache-no-verify-local] [--user-agent UA] [--accept-language VALUE] [--accept-encoding VALUE] [--include-parent-domains] URL [ඉලක්කය]"
si.usage.description = "වෙබ් අඩවියක් පුනරාවර්තීව ඉලක්කයට හෝ වත්මන් නාමාවලියට ලබා ගනී."
si.usage.scheme = "http:// හෝ https:// නොමැති URL http:// සමඟ ලබාගනී."
si.usage.quiet = "ප්‍රගතිය හා සාරාංශය සැඟවීමට --quiet හෝ -q භාවිත කරන්න."
si.usage.verbose = "cache, නැවත උත්සාහ, නැවත ආරම්භ, robots සහ මඟහැරීමේ විනිශ්චය පෙන්වීමට --verbose හෝ -v භාවිතා කරන්න."
si.usage.locale = "හඳුනාගත් පද්ධති භාෂාව ප්‍රතික්ෂේප කිරීමට --locale LOCALE භාවිත කරන්න."
si.error.prefix = "sitefetch: {message}"
si.error.target_empty = "ඉලක්ක මාර්ගය හිස් විය නොහැක"
si.error.target_not_directory = "ඉලක්කය පවතී නමුත් එය නාමාවලියක් නොවේ: {target}"
si.error.target_inspect = "ඉලක්ක මාර්ගය පරීක්ෂා කළ නොහැක: {target}"
si.error.locale_missing = "--locale පසු පෙදෙස නොමැත"
si.error.locale_empty = "පෙදෙස හිස් විය නොහැක"
