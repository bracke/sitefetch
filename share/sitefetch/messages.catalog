jv.usage.line1 = "panggunaan: sitefetch [--help] [--version]"
jv.usage.line2 = "       sitefetch [--quiet|-q] [--verbose|-v] [--locale LOCALE] [--jsonl] [--json-summary] [--max-pages N] [--max-depth N] [--max-bytes N] [--max-failures N] [--retries N] [--retry-delay-ms N] [--retry-jitter-ms N] [--request-delay-ms N] [--workers N] [--skip-dangerous] [--safe] [--head MODE] [--robots] [--cache MODE] [--incremental] [--refresh-cache] [--offline-cache] [--cache-max-stale-ms N] [--cache-hash MODE] [--cache-documents-only|--cache-downloads-only] [--cache-require-version] [--cache-no-verify-local] [--user-agent UA] [--accept-language VALUE] [--accept-encoding VALUE] [--include-parent-domains] URL [tujuan]"
jv.usage.description = "Njupuk situs web kanthi rekursif menyang tujuan, utawa direktori saiki."
jv.usage.scheme = "URL tanpa http:// utawa https:// dijupuk nganggo http://."
jv.usage.quiet = "Gunakake --quiet utawa -q kanggo ndhelikake kemajuan lan ringkesan."
jv.usage.verbose = "Gunakake --verbose utawa -v kanggo nuduhake diagnostik cache, nyoba maneh, nerusake, robots lan ngliwati."
jv.usage.locale = "Gunakake --locale LOCALE kanggo ngganti basa sistem sing kadeteksi."
jv.error.prefix = "sitefetch: {message}"
jv.error.target_empty = "path tujuan ora kena kosong"
jv.error.target_not_directory = "tujuan ana nanging dudu direktori: {target}"
jv.error.target_inspect = "ora bisa mriksa path tujuan: {target}"
jv.error.locale_missing = "lokal ora ana sawise --locale"
jv.error.locale_empty = "lokal ora kena kosong"
jv.error.unknown_option = "opsi ora dikenal: {option}"
jv.error.too_many_arguments = "kakehan argumen"
jv.error.missing_url = "URL ora ana"
jv.error.fetch_exception = "jupukan gagal sadurunge rampung"
jv.version = "sitefetch {version}"
jv.start.fetching = "njupuk: {url}"
jv.start.target = "tujuan:   {target}"
