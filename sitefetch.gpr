with "config/sitefetch_config.gpr";

project Sitefetch is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sitefetch_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("start.adb", "check_sitefetch.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Sitefetch_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Executable ("start.adb") use "sitefetch";
      for Executable ("check_sitefetch.adb") use "check_sitefetch";
   end Builder;

   package Linker is
      case Sitefetch_Config.Alire_Host_OS is
         when "windows" =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto", "-lws2_32", "-lcrypt32");
         when others =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto");
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sitefetch;
