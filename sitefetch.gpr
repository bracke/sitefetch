with "config/sitefetch_config.gpr";

project Sitefetch is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sitefetch_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("start.adb", "check_sitefetch.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Sitefetch_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Builder is
      for Executable ("start.adb") use "sitefetch";
      for Executable ("check_sitefetch.adb") use "check_sitefetch";
   end Builder;

   package Linker is
      case Sitefetch_Config.Alire_Host_OS is
         when "windows" =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto", "-lws2_32", "-lcrypt32");
         when others =>
            for Default_Switches ("Ada") use ("-lssl", "-lcrypto");
      end case;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sitefetch;
